# --- Basis ---------------------------------------------------------------
# Wird für kanonische URLs, OpenGraph und sitemap.xml verwendet.
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# --- Affiliate-Netzwerke --------------------------------------------------
# Amazon PartnerNet Tracking-ID (Format: deinname-21)
NEXT_PUBLIC_AMAZON_TAG=deintag-21

# Awin Publisher-ID (nur die Zahl, z. B. 123456)
NEXT_PUBLIC_AWIN_ID=

# Impact / Digistore24 Partner-ID (frei nutzbar als generischer Sub-ID-Wert)
NEXT_PUBLIC_PARTNER_ID=

# Wert für den UTM-Parameter `utm_source` (Standard: deal-finder)
NEXT_PUBLIC_UTM_SOURCE=deal-finder
